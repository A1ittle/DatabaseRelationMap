# Copy this file to deploy/.env and edit locally.
# 真实 .env 已被仓库 .gitignore 忽略，切勿提交密码或生产连接信息。
# Real .env is gitignored. Placeholders only — not production credentials.

# PostgreSQL 17（本地可销毁实例 / disposable local instance）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lineage
POSTGRES_USER=lineage
POSTGRES_PASSWORD=change-me-local

# API datasource（Java 8 / Spring Boot 2.7）。Names must match Spring env.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lineage
SPRING_DATASOURCE_USERNAME=lineage
SPRING_DATASOURCE_PASSWORD=change-me-local

# P2 Flyway: when SPRING_DATASOURCE_URL is set, the API enables Flyway unless this is false.
FLYWAY_ENABLED=true
