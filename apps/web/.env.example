# Copy to apps/web/.env.local if you need to override (gitignored).
# Prefer same-origin reverse-proxy and empty VITE_API_BASE (no CORS).
VITE_API_BASE=http://127.0.0.1:8080
# Must match lineage.csrf.token (API default `dev`). Hosts: set a non-guessable token.
VITE_CSRF_TOKEN=dev
# Optional host-trusted embed groups (comma-separated). Omit for open-mode full snapshot.
# When set, import/publish require scope_grant permission=ingest.
# VITE_EMBED_GROUPS=
